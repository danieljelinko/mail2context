# Proton — via Proton Mail Bridge running locally.
# Get these from: /usr/lib/protonmail/bridge/bridge --cli  →  info
# PROTON_PASS is the Bridge-GENERATED password, never your Proton account password.
PROTON_USER=
PROTON_PASS=
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SMTP_HOST=127.0.0.1
PROTON_SMTP_PORT=1025

# Gmail — 16-char app password from myaccount.google.com → Security → App passwords.
# Requires 2-Step Verification on the account.
GMAIL_USER=daniel.jelinko@gmail.com
GMAIL_PASS=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
