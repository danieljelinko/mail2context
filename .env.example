# Proton — via Proton Mail Bridge running locally.
# Get these from: /usr/lib/protonmail/bridge/bridge --cli  →  info
# PROTON_PASS is the Bridge-GENERATED password, never your Proton account password.
PROTON_USER=
PROTON_PASS=
PROTON_IMAP_HOST=127.0.0.1
PROTON_IMAP_PORT=1143
PROTON_SMTP_HOST=127.0.0.1
PROTON_SMTP_PORT=1025
# With mail-guard installed (~/Work/tools/mail-guard), point at its plaintext loopback listeners instead and
# use the guard token as PROTON_PASS — install.sh writes the exact lines to /etc/mail-guard/mail2context.env:
#   PROTON_IMAP_PORT=2143  PROTON_IMAP_TLS=none  PROTON_SMTP_PORT=2025  PROTON_SMTP_TLS=none
# *_IMAP_TLS is starttls | tls | none (default: starttls on loopback, tls elsewhere); *_SMTP_TLS is starttls | none.

# Gmail — 16-char app password from myaccount.google.com → Security → App passwords.
# Requires 2-Step Verification on the account.
GMAIL_USER=daniel.jelinko@gmail.com
GMAIL_PASS=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
# SMTP submission uses the SAME app password as IMAP. 587 is STARTTLS.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
